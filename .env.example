# ============================================================================
#  Dujiao-Next 简易自部署 —— 环境变量模板
#
#  两种初始化方式（二选一）：
#    1) 推荐：运行  ./setup.sh   —— 自动生成随机密钥 / 随机后台路径 / 强管理员密码，
#        产物为 .env（已被 .gitignore 忽略，不会提交）。
#    2) 手动：复制本文件为 .env 后逐项修改。
#       注意：三个密钥必须各自 >=32 位、互不相同、且不含默认词，否则服务拒绝启动
#       （本文件的占位值就是故意写弱、用来强制你走 setup.sh 或自己生成）。
#
#  环境变量优先级高于 config.yml；未设置的项使用内置默认值。
# ============================================================================

# ---- 对外访问 ----
# 宿主机映射端口（容器内部固定 8080）。修改这里即可换对外端口。
APP_PORT=8080

# ---- 运行模式 ----
# debug / release。release 会开启安全校验（弱密钥直接拒绝启动等）。
SERVER_MODE=release

# ---- 三个运行时密钥：必须 >=32 位、互不相同、不得包含默认词 ----
# 生成方式：openssl rand -hex 32   （执行三次，分别填入）
# setup.sh 会自动生成并填入；下面的占位值会让服务拒绝启动（fail-safe）。
APP_SECRET_KEY=change-me-placeholder-please-run-setup-sh
JWT_SECRET=change-me-placeholder-please-run-setup-sh-2
USER_JWT_SECRET=change-me-placeholder-please-run-setup-sh-3

# ---- 后台访问路径 ----
# 以 / 开头、不可为 /；建议随机化以免被扫描，例如 /dj-a75d2ce3b1。
# setup.sh 会自动生成 /dj-xxxxxxxx。
# 本占位值 /api 是保留路径，服务会拒绝启动（fail-safe）——不替换就没法跑，
# 逼你改成自己的随机路径，避免「忘了改」导致后台地址公开可被扫描。
WEB_ADMIN_PATH=/api

# ---- 初始管理员（仅首次启动用于创建默认管理员）----
# SERVER_MODE=release 时若未设置强密码，服务会拒绝启动并提示改用 ./setup.sh。
# 忘记密码时可事后重置：
#   docker compose exec app ./dujiao-next admin list-admins
#   docker compose exec app ./dujiao-next admin reset-password --username <管理员用户名>
DJ_DEFAULT_ADMIN_USERNAME=admin
DJ_DEFAULT_ADMIN_PASSWORD=change-me

# ---- Redis / 异步队列 ----
# compose 默认启动内置 Redis 并已在 docker-compose.yml 里把 host 指向它。
# REDIS_ENABLED=false 只关闭 Redis 缓存/限流等功能。
# 警告：QUEUE_ENABLED=false 会让应用在默认 all 模式下拒绝启动（需把
# docker-compose.yml 的 app.command 改为 ./dujiao-next -mode api 才能只跑 API），
# 一般不需要关闭，请保持 true。
REDIS_ENABLED=true
QUEUE_ENABLED=true

# ---- 分销/代理模式（默认关闭）----
RESELLER_ENABLED=false
# 分销商是否可开设独立子站（仅 RESELLER_ENABLED=true 时有意义）
RESELLER_SUB_SITES_ENABLED=false

# ---- 邮件通知（可选；注册 / 找回密码等邮件通知会用到）----
# EMAIL_ENABLED=false
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=465
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM=
# EMAIL_FROM_NAME=

# ---- Telegram 登录（可选）----
# TELEGRAM_AUTH_ENABLED=false
# TELEGRAM_AUTH_BOT_USERNAME=
# TELEGRAM_AUTH_BOT_TOKEN=

# ---- Google 登录（可选）----
# GOOGLE_AUTH_ENABLED=false
# GOOGLE_AUTH_CLIENT_ID=

# ---- 其他常用项（可选，均有默认值）----
# JWT_EXPIRE_HOURS=24
# USER_JWT_EXPIRE_HOURS=24
# USER_JWT_REMEMBER_ME_EXPIRE_HOURS=168
# ORDER_PAYMENT_EXPIRE_MINUTES=15
# UPLOAD_MAX_SIZE=10485760
